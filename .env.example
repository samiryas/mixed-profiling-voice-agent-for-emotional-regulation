OPENAI_KEY=your_openai_api_key
OPENAI_MODEL=your_model_name
OPENAI_URL=your_openai_endpoint

DATABASE_URL=sqlite:///db.sqlite3
REDIS_URL=

OTREE_ADMIN_PASSWORD=your_admin_password
OTREE_SECRET_KEY=your_secret_key
OTREE_AUTH_LEVEL=STUDY
OTREE_PRODUCTION=0

# --- Voice session (Module 2) ---
# Service backends default to local stubs so the turn loop runs without keys.
# Flip each to a real backend when wiring it (see Voice/services.py).
#   STT: stub | whisper-local   LLM: stub | kit   TTS: stub | elevenlabs
VOICE_STT_BACKEND=stub
VOICE_LLM_BACKEND=stub
VOICE_TTS_BACKEND=stub
# T1 = profile withheld from agent | T2 = profile injected | T3 = T2 + live adaptation
VOICE_CONDITION=T2
# ElevenLabs (only used when VOICE_TTS_BACKEND=elevenlabs)
ELEVENLABS_KEY=
VOICE_ID=rf6Kp06FksMr0VCBn1Pf
# faster-whisper model size (only used when VOICE_STT_BACKEND=whisper-local)
# WHISPER_MODEL=base
# The KIT LLM backend reuses OPENAI_URL / OPENAI_MODEL / OPENAI_KEY above.
