OPENAI_KEY=your_openai_api_key
OPENAI_MODEL=your_model_name
OPENAI_URL=your_openai_endpoint

# --- Database & cache ---
# PostgreSQL credentials — consumed by docker-compose to provision the `db` service.
POSTGRES_USER=otree
POSTGRES_PASSWORD=otree
POSTGRES_DB=otree
# oTree auto-selects Postgres whenever DATABASE_URL is a postgres URL (else SQLite).
# Host-run oTree (devserver/prodserver on your machine) reaches the compose
# services over localhost. The containerized `web` service overrides these to the
# `db`/`redis` compose hostnames automatically — see docker-compose.yml.
DATABASE_URL=postgresql://otree:otree@localhost:5432/otree
REDIS_URL=redis://localhost:6379

OTREE_ADMIN_PASSWORD=your_admin_password
OTREE_SECRET_KEY=your_secret_key
OTREE_AUTH_LEVEL=STUDY
OTREE_PRODUCTION=0

# --- Voice session (Module 2) ---
# Service backends default to local stubs so the turn loop runs without keys.
# Flip each to a real backend when wiring it (see Voice/services.py).
#   STT: stub | whisper-local   LLM: stub | kit   TTS: stub | elevenlabs
VOICE_STT_BACKEND=stub
VOICE_LLM_BACKEND=stub
VOICE_TTS_BACKEND=stub
# T1 = profile withheld from agent | T2 = profile injected | T3 = T2 + live adaptation
VOICE_CONDITION=T2
# Agent language — selects the prompt set under Voice/prompts/<lang>/ (en | de). Use `de` for the study.
VOICE_LANG=en
# Four-phase pacing (D18). Per-phase minimum seconds before the LLM's readiness flag is honoured;
# override individually via VOICE_PHASE_MIN_CHECKIN / _TECHNIQUE / _PRACTICE / _REFLECTION.
# Set VOICE_FAST_PHASES=1 to collapse all minimums to ~2s for quick manual testing.
# VOICE_FAST_PHASES=0
# ElevenLabs (only used when VOICE_TTS_BACKEND=elevenlabs)
# NOTE: free-tier API keys can ONLY use *default* voices, not "library" voices
# (library voices return 402 paid_plan_required). Known free-tier-OK voice IDs:
#   Sarah=EXAVITQu4vr4xnSDxMaL  Laura=FGY2WhTYpPnrIDTdsKH5  George=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_KEY=
VOICE_ID=EXAVITQu4vr4xnSDxMaL
# faster-whisper model size (only used when VOICE_STT_BACKEND=whisper-local)
# WHISPER_MODEL=base
# The KIT LLM backend reuses OPENAI_URL / OPENAI_MODEL / OPENAI_KEY above.
